<Window x:Class="LineBuddy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chitti" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="#AA000000"
        ResizeMode="NoResize" 
        Topmost="True"
        ShowInTaskbar="False"
        Icon="chitti.ico">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <!-- Logo before textbox -->
        <Button Grid.Column="0"
                Click="Logo_Click"
                Background="Transparent"
                BorderThickness="0"
                Padding="0"
                Margin="10,0,5,0"
                Cursor="Hand"
                ToolTip="Click to open Chitti Info">
            
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Effect="{TemplateBinding Effect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="White" Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.1"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            
            <Image Source="chitti.png"
                   Width="20"
                   Height="20"
                   Stretch="Uniform"/>
        </Button>
        
        <!-- Smart Tags Bubble -->
        <Button x:Name="SmartTagsBubble"
                Grid.Column="1"
                Width="70"
                Height="24"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                ToolTip="Click to toggle Smart Tags"
                Click="SmartTagsBubble_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Effect="{TemplateBinding Effect}">
                        <Grid>
                            <!-- Content -->
                            <StackPanel Orientation="Horizontal" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center">
                                <TextBlock x:Name="IconText" 
                                          Text="⚡" 
                                          FontSize="10" 
                                          Margin="0,0,3,0"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" 
                                          Text="LISTENING" 
                                          FontSize="8" 
                                          FontWeight="Medium"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Glass effect overlay -->
                            <Border CornerRadius="12" 
                                    Background="White" 
                                    Opacity="0.1"/>
                            
                            <!-- Animated glow for processing -->
                            <Border x:Name="GlowBorder"
                                    CornerRadius="12"
                                    Background="Transparent"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="GlowEffect"
                                                    ShadowDepth="0"
                                                    BlurRadius="15"
                                                    Color="White"
                                                    Opacity="0"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="White" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#22007ACC"/>
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                    <Setter Property="Foreground" Value="#007ACC"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="5" Color="Black" Opacity="0.2"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        
        <!-- Screenshot Toggle Button -->
        <Button x:Name="ScreenshotToggle"
                Grid.Column="2"
                Width="30"
                Height="30"
                Margin="5,0,5,0"
                VerticalAlignment="Center"
                Click="ScreenshotToggle_Click"
                ToolTip="Toggle screenshot context (Off by default)">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="BorderElement"
                            Background="{TemplateBinding Background}"
                            CornerRadius="15"
                            Effect="{TemplateBinding Effect}">
                        <Grid>
                            <TextBlock x:Name="ScreenshotIcon" 
                                       Text="📷" 
                                       FontSize="14" 
                                       Foreground="#666666"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            
                            <!-- Glass effect overlay -->
                            <Border CornerRadius="15" 
                                    Background="White" 
                                    Opacity="0.05"/>
                        </Grid>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="White" Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="BorderElement" Property="Background" Value="#22FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="BorderElement" Property="Background" Value="#33FFFFFF"/>
                            <Setter TargetName="ScreenshotIcon" Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.1"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        
        <!-- AI Chat Input -->
        <Border Grid.Column="3" 
                Background="#33FFFFFF" 
                CornerRadius="15" 
                Margin="0,5,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="QueryTextBox"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="LightGray"
                         FontSize="14"
                         VerticalAlignment="Center"
                         TextAlignment="Left"
                         TextWrapping="NoWrap"
                         AcceptsReturn="False"
                         AcceptsTab="False"
                         Padding="0"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MinLines="1"
                         MaxLines="1"
                         Margin="12,0,8,0"
                         Text="Starting Chitti..."
                         KeyDown="QueryTextBox_KeyDown"
                         GotFocus="QueryTextBox_GotFocus"
                         LostFocus="QueryTextBox_LostFocus"
                         TextChanged="QueryTextBox_TextChanged"/>
                
                <Button x:Name="ClearButton"
                        Grid.Column="1"
                        Content="✕"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontSize="12"
                        Width="20"
                        Height="20"
                        Margin="5,0,10,0"
                        Cursor="Hand"
                        Click="ClearButton_Click">
                    
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BorderElement"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Effect="{TemplateBinding Effect}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BorderElement" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="White" Opacity="0.2"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.1"/>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
        
        <!-- Right side: System Information -->
        <StackPanel Grid.Column="4" 
                    Orientation="Horizontal" 
                    Margin="5,5,10,5"
                    VerticalAlignment="Center">
            
            <Label x:Name="TimeLabel"
                   Content="00:00"
                   Foreground="White"
                   FontSize="12"
                   Padding="5,0"
                   VerticalAlignment="Center"
                   Margin="3,0"/>
            
            <Label x:Name="BatteryLabel"
                   Content="🔋 100%"
                   Foreground="White"
                   FontSize="12"
                   Padding="5,0"
                   VerticalAlignment="Center"
                   Margin="3,0"/>
            
            <Button x:Name="SettingsButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    VerticalAlignment="Center"
                    Margin="5,0"
                    Click="SettingsButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Effect="{TemplateBinding Effect}">
                            <Grid>
                                <TextBlock Text="⚙"
                                           FontSize="12"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                
                                <!-- Glass effect overlay -->
                                <Border CornerRadius="14" 
                                        Background="White" 
                                        Opacity="0.05"/>
                            </Grid>
                        </Border>
                        
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElement" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="8" Color="White" Opacity="0.2"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BorderElement" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="3" Color="Black" Opacity="0.1"/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                
                <Button.ContextMenu>
                    <ContextMenu x:Name="SettingsContextMenu">
                        <MenuItem Header="Settings" Click="Settings_Click"/>
                        <Separator/>
                        <MenuItem Header="ℹ️ About" Click="About_Click"/>
                        <MenuItem Header="❓ How to Use" Click="HowToUse_Click"/>
                        <MenuItem Header="🤝 Contribute" Click="Contribute_Click"/>
                        <Separator/>
                        <MenuItem Header="Minimize" Click="Minimize_Click"/>
                        <MenuItem Header="Restart" Click="Restart_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="Exit_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>
    </Grid>
</Window>