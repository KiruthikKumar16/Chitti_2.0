<Window x:Class="LineBuddy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Bar Settings" 
        Height="600" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FF2D2D30"
        Foreground="White">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Tabbed Content -->
        <TabControl Grid.Row="0" Background="#FF2D2D30" BorderThickness="0" Margin="10">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" 
                                        Background="#FF3F3F46" 
                                        BorderBrush="#FF686868" 
                                        BorderThickness="1,1,1,0" 
                                        CornerRadius="5,5,0,0" 
                                        Margin="0,0,2,0">
                                    <ContentPresenter x:Name="ContentSite" 
                                                      VerticalAlignment="Center" 
                                                      HorizontalAlignment="Center" 
                                                      ContentSource="Header" 
                                                      Margin="10,5"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#FF007ACC"/>
                                        <Setter TargetName="Border" Property="BorderBrush" Value="#FF007ACC"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#FF4A4A50"/>
                                    </Trigger>
                                    <!-- Override mouse over when selected -->
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Border" Property="Background" Value="#FF0099DD"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="White"/>
                </Style>
            </TabControl.Resources>
            
            <!-- General Settings Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF2D2D30">
                    <StackPanel Margin="20">
            
            <!-- Update Interval Settings -->
            <GroupBox Header="Message Update Settings" Foreground="White" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <Label Content="Update Interval (minutes):" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Slider x:Name="IntervalSlider" 
                                Minimum="1" 
                                Maximum="60" 
                                Value="5" 
                                Width="200" 
                                TickFrequency="5" 
                                IsSnapToTickEnabled="True"
                                ValueChanged="IntervalSlider_ValueChanged"/>
                        <Label x:Name="IntervalLabel" 
                               Content="5 minutes" 
                               Foreground="White" 
                               Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Message Types Settings -->
            <GroupBox Header="Message Types to Display" Foreground="White" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    
                    <CheckBox x:Name="TimeBasedCheckBox" 
                              Content="⏰ Time-based messages (greetings, reminders)" 
                              Foreground="White" 
                              IsChecked="True" 
                              Margin="0,5"/>
                    
                    <CheckBox x:Name="SystemHealthCheckBox" 
                              Content="💻 System health (CPU, RAM usage)" 
                              Foreground="White" 
                              IsChecked="True" 
                              Margin="0,5"/>
                    
                    <CheckBox x:Name="NetworkStatusCheckBox" 
                              Content="🌐 Network status (speed, latency)" 
                              Foreground="White" 
                              IsChecked="True" 
                              Margin="0,5"/>
                    
                    <CheckBox x:Name="ProductivityCheckBox" 
                              Content="🎯 Productivity tips and reminders" 
                              Foreground="White" 
                              IsChecked="True" 
                              Margin="0,5"/>
                    
                    <CheckBox x:Name="WeatherCheckBox" 
                              Content="🌤️ Weather updates" 
                              Foreground="White" 
                              IsChecked="True" 
                              Margin="0,5"/>
                    
                    <CheckBox x:Name="StockCheckBox" 
                              Content="📈 Stock market updates" 
                              Foreground="White" 
                              IsChecked="True" 
                              Margin="0,5"/>
                    
                    <CheckBox x:Name="CryptoCheckBox" 
                              Content="₿ Cryptocurrency updates" 
                              Foreground="White" 
                              IsChecked="True" 
                              Margin="0,5"/>
                    
                    <CheckBox x:Name="TechNewsCheckBox" 
                              Content="📰 Tech news headlines" 
                              Foreground="White" 
                              IsChecked="True" 
                              Margin="0,5"/>
                </StackPanel>
            </GroupBox>

            <!-- Animation Settings -->
            <GroupBox Header="Animation Settings" Foreground="White" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <Label Content="Typing Animation Speed (milliseconds per character):" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Slider x:Name="TypingSpeedSlider" 
                                Minimum="0" 
                                Maximum="100" 
                                Value="30" 
                                Width="200" 
                                TickFrequency="10" 
                                IsSnapToTickEnabled="True"
                                ValueChanged="TypingSpeedSlider_ValueChanged"/>
                        <Label x:Name="TypingSpeedLabel" 
                               Content="30ms (Normal)" 
                               Foreground="White" 
                               Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="💡 Set to 0 for instant text (no animation)" 
                               Foreground="Orange" 
                               FontSize="11" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Conversation History Settings -->
            <GroupBox Header="Conversation History" Foreground="White" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <CheckBox x:Name="HistoryEnabledCheckBox" 
                              Content="💬 Enable conversation history (provides context to AI)" 
                              Foreground="White" 
                              IsChecked="True" 
                              Margin="0,5"
                              Checked="HistoryEnabledCheckBox_Changed"
                              Unchecked="HistoryEnabledCheckBox_Changed"/>
                    
                    <Label Content="Number of recent messages to include in context:" Foreground="White" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <Slider x:Name="HistoryRangeSlider" 
                                Minimum="3" 
                                Maximum="20" 
                                Value="10" 
                                Width="200" 
                                TickFrequency="1" 
                                IsSnapToTickEnabled="True"
                                ValueChanged="HistoryRangeSlider_ValueChanged"/>
                        <Label x:Name="HistoryRangeLabel" 
                               Content="10 messages" 
                               Foreground="White" 
                               Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="💡 Higher values provide more context but may slow responses" 
                               Foreground="Orange" 
                               FontSize="11" 
                               Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Watchlists Settings -->
            <GroupBox Header="Watchlists" Foreground="White" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    
                    <Label Content="Stock Watchlist (comma-separated):" Foreground="White"/>
                    <TextBox x:Name="StockWatchlistTextBox" 
                             Text="AAPL, GOOGL, MSFT, TSLA, NVDA"
                             Background="#FF3F3F46" 
                             Foreground="White" 
                             BorderBrush="#FF686868"
                             Margin="0,5,0,10"/>
                    
                    <Label Content="Crypto Watchlist (comma-separated):" Foreground="White"/>
                    <TextBox x:Name="CryptoWatchlistTextBox" 
                             Text="bitcoin, ethereum, dogecoin"
                             Background="#FF3F3F46" 
                             Foreground="White" 
                             BorderBrush="#FF686868"
                             Margin="0,5,0,10"/>
                    
                    <Label Content="Weather Location:" Foreground="White"/>
                    <TextBox x:Name="WeatherLocationTextBox" 
                             Text="London"
                             Background="#FF3F3F46" 
                             Foreground="White" 
                             BorderBrush="#FF686868"
                             Margin="0,5,0,10"/>
                </StackPanel>
            </GroupBox>
            
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Smart Tags Tab -->
            <TabItem Header="Smart Tags">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF2D2D30">
                    <StackPanel Margin="20">
                        
                        <!-- Smart Tags Configuration -->
                        <GroupBox Header="Smart Tags Configuration" Foreground="White" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="SmartTagsEnabledCheckBox" 
                                          Content="🏷️ Enable Smart Tags (clipboard monitoring)" 
                                          Foreground="White" 
                                          IsChecked="True" 
                                          Margin="0,5"
                                          Checked="SmartTagsEnabledCheckBox_Changed"
                                          Unchecked="SmartTagsEnabledCheckBox_Changed"/>
                                
                                <Label Content="Typing Animation Speed for Pasting (milliseconds per character):" Foreground="White" Margin="0,10,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Slider x:Name="PastingSpeedSlider" 
                                            Minimum="0" 
                                            Maximum="200" 
                                            Value="50" 
                                            Width="200" 
                                            TickFrequency="25" 
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="PastingSpeedSlider_ValueChanged"/>
                                    <Label x:Name="PastingSpeedLabel" 
                                           Content="50ms (Normal)" 
                                           Foreground="White" 
                                           Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="💡 Set to 0 for instant pasting (no animation)" 
                                           Foreground="Orange" 
                                           FontSize="11" 
                                           Margin="0,5,0,10"/>
                                
                                <!-- Screenshot Settings -->
                                <Separator Background="#FF555555" Margin="0,10"/>
                                <Label Content="Screen Context Settings:" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                                <CheckBox x:Name="ScreenshotContextCheckBox" 
                                          Content="📷 Enable screenshot context for Smart Bar queries (disabled by default)" 
                                          Foreground="White" 
                                          IsChecked="False" 
                                          Margin="0,5"/>
                                <CheckBox x:Name="ActiveWindowOnlyCheckBox" 
                                          Content="🖼️ Capture active window only (vs full screen - default)" 
                                          Foreground="White" 
                                          IsChecked="False" 
                                          Margin="0,5"/>
                                <TextBlock Text="💡 /screen tag automatically captures screenshots for context" 
                                           Foreground="Orange" 
                                           FontSize="11" 
                                           Margin="0,5,0,10"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Available Smart Tags -->
                        <GroupBox Header="Available Smart Tags" Foreground="White" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <Label Content="Built-in Smart Tags:" Foreground="White" Margin="0,0,0,5"/>
                                <ScrollViewer Height="160" VerticalScrollBarVisibility="Auto" Background="#FF3F3F46" Margin="0,0,0,10">
                                    <StackPanel x:Name="BuiltInTagsPanel" Margin="10">
                                        <CheckBox Content="/grammar - Fix grammar and spelling errors" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/polite - Make text more polite and professional" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/casual - Make text more casual and friendly" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/formal - Make text more formal and business-like" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/short - Make text more concise and brief" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/expand - Add more detail and explanation" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/solve - Solve problems or answer questions" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/translate - Translate text to English" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/screen - Process with screen context (auto-captures screenshot)" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/summarize - Create a brief summary" Foreground="White" IsChecked="True" Margin="0,3"/>
                                        <CheckBox Content="/explain - Provide detailed explanation" Foreground="White" IsChecked="True" Margin="0,3"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Custom Smart Tags -->
                        <GroupBox Header="Custom Smart Tags" Foreground="White" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <Label Content="Create Custom Tags:" Foreground="White" Margin="0,0,0,5"/>
                                
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Label Grid.Row="0" Grid.Column="0" Content="Tag Name:" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBox x:Name="CustomTagNameTextBox" 
                                             Grid.Row="0" Grid.Column="1"
                                             Background="#FF3F3F46" 
                                             Foreground="White" 
                                             BorderBrush="#FF686868"
                                             Margin="5,0"
                                             VerticalAlignment="Center"
                                             Text="/custom"/>
                                    
                                    <Label Grid.Row="1" Grid.Column="0" Content="Description:" Foreground="White" VerticalAlignment="Top" Margin="0,5,0,0"/>
                                    <TextBox x:Name="CustomTagDescriptionTextBox" 
                                             Grid.Row="1" Grid.Column="1"
                                             Background="#FF3F3F46" 
                                             Foreground="White" 
                                             BorderBrush="#FF686868"
                                             Margin="5,5,5,0"
                                             Height="60"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="Enter instruction for your custom tag"/>
                                    
                                    <Button x:Name="AddCustomTagButton" 
                                            Grid.Row="1" Grid.Column="2"
                                            Content="Add Tag" 
                                            Background="#FF007ACC" 
                                            Foreground="White" 
                                            BorderThickness="0"
                                            Padding="5"
                                            Margin="5,5,0,0"
                                            VerticalAlignment="Top"
                                            Click="AddCustomTagButton_Click"/>
                                </Grid>
                                
                                <Label Content="Your Custom Tags:" Foreground="White" Margin="0,15,0,5"/>
                                <ListView x:Name="CustomTagsList" 
                                          Height="120" 
                                          Background="#FF3F3F46" 
                                          Foreground="White" 
                                          BorderBrush="#FF686868"
                                          Margin="0,0,0,0">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Tag" Width="100" DisplayMemberBinding="{Binding Name}"/>
                                            <GridViewColumn Header="Description" Width="280" DisplayMemberBinding="{Binding Description}"/>
                                            <GridViewColumn Header="Action" Width="60">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Remove" Background="#FF555555" Foreground="White" BorderThickness="0" Padding="5,2" FontSize="10"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </GroupBox>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- LLM Configuration Tab -->
            <TabItem Header="LLM Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FF2D2D30">
                    <StackPanel Margin="20">
                        
                        <!-- LLM Provider Configuration -->
                        <GroupBox Header="LLM Provider Configuration" Foreground="White" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <Label Content="Choose your AI provider:" Foreground="White" Margin="0,0,0,5"/>
                                <ComboBox x:Name="LLMProviderComboBox" 
                                          Background="#FF3F3F46" 
                                          Foreground="White" 
                                          BorderBrush="#FF686868"
                                          Margin="0,0,0,10"
                                          SelectionChanged="LLMProviderComboBox_SelectionChanged">
                                    <ComboBox.Resources>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="#FF3F3F46"/>
                                            <Setter Property="BorderBrush" Value="#FF686868"/>
                                        </Style>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="#FF3F3F46"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter Property="Background" Value="#FF007ACC"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#FF005A9B"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Google Gemini (Fast)" Tag="gemini"/>
                                    <ComboBoxItem Content="OpenAI GPT (Fast)" Tag="openai"/>
                                    <ComboBoxItem Content="Anthropic Claude (Fast)" Tag="anthropic"/>
                                </ComboBox>
                                             
                                <Label Content="API Key:" Foreground="White" Margin="0,15,0,5"/>
                                <PasswordBox x:Name="LLMApiKeyPasswordBox" 
                                             Background="#FF3F3F46" 
                                             Foreground="White" 
                                             BorderBrush="#FF686868"
                                             Margin="0,0,0,10"/>
                                             
                                <TextBlock Text="💡 Get your API key from your provider's dashboard" 
                                           Foreground="Orange" 
                                           FontSize="11" 
                                           Margin="0,0,0,10"/>
                                           
                                <TextBlock x:Name="AutoModelInfo" 
                                           Text="� Using optimized fast model for best performance" 
                                           Foreground="LightGreen" 
                                           FontSize="11" 
                                           Margin="0,0,0,10"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <!-- Provider-Specific Help -->
                        <GroupBox Header="Provider Setup Help" Foreground="White" Margin="0,0,0,15">
                            <StackPanel Margin="10">
                                <StackPanel x:Name="GeminiHelpPanel" Visibility="Visible">
                                    <Label Content="Google Gemini Setup:" Foreground="#FF007ACC" FontWeight="Bold"/>
                                    <TextBlock Text="1. Go to https://makersuite.google.com/app/apikey" 
                                               Foreground="White" 
                                               Margin="0,2"/>
                                    <TextBlock Text="2. Create a new API key" 
                                               Foreground="White" 
                                               Margin="0,2"/>
                                    <TextBlock Text="3. Copy and paste the key above" 
                                               Foreground="White" 
                                               Margin="0,2"/>
                                    <TextBlock Text="✨ Auto-using: gemini-2.0-flash-exp (fastest with image support)" 
                                               Foreground="LightGreen" 
                                               Margin="0,2,0,10"/>
                                </StackPanel>
                                
                                <StackPanel x:Name="OpenAIHelpPanel" Visibility="Collapsed">
                                    <Label Content="OpenAI Setup:" Foreground="#FF007ACC" FontWeight="Bold"/>
                                    <TextBlock Text="1. Go to https://platform.openai.com/api-keys" 
                                               Foreground="White" 
                                               Margin="0,2"/>
                                    <TextBlock Text="2. Create a new secret key" 
                                               Foreground="White" 
                                               Margin="0,2"/>
                                    <TextBlock Text="3. Copy and paste the key above" 
                                               Foreground="White" 
                                               Margin="0,2"/>
                                    <TextBlock Text="✨ Auto-using: gpt-4o-mini (fastest, cheapest model)" 
                                               Foreground="LightGreen" 
                                               Margin="0,2,0,10"/>
                                </StackPanel>
                                
                                <StackPanel x:Name="AnthropicHelpPanel" Visibility="Collapsed">
                                    <Label Content="Anthropic Claude Setup:" Foreground="#FF007ACC" FontWeight="Bold"/>
                                    <TextBlock Text="1. Go to https://console.anthropic.com/account/keys" 
                                               Foreground="White" 
                                               Margin="0,2"/>
                                    <TextBlock Text="2. Create a new API key" 
                                               Foreground="White" 
                                               Margin="0,2"/>
                                    <TextBlock Text="3. Copy and paste the key above" 
                                               Foreground="White" 
                                               Margin="0,2"/>
                                    <TextBlock Text="✨ Auto-using: claude-3-haiku-20240307 (fastest model)" 
                                               Foreground="LightGreen" 
                                               Margin="0,2,0,10"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
        </TabControl>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20">
            <Button x:Name="SaveButton" 
                    Content="Save" 
                    Background="#FF007ACC" 
                    Foreground="White" 
                    BorderThickness="0"
                    Padding="20,8"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            
            <Button x:Name="CancelButton" 
                    Content="Cancel" 
                    Background="#FF555555" 
                    Foreground="White" 
                    BorderThickness="0"
                    Padding="20,8"
                    Click="CancelButton_Click"/>
        </StackPanel>
        
    </Grid>
</Window>