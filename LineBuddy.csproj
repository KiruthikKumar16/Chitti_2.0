<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Chitti</AssemblyName>
    <RootNamespace>LineBuddy</RootNamespace>
    <ApplicationIcon>chitti.ico</ApplicationIcon>
    <StartupObject>LineBuddy.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="chitti.ico" />
    <Resource Include="chitti.png" />
    <None Include="personality.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>